# Copy to .env.local and fill in from the Supabase dashboard.
# .env.local is gitignored; this file is the committed template and must stay empty.

# The site's canonical origin: the address invite links, check-in QR codes,
# og:image URLs, robots.txt and sitemap.xml are all built on.
#
# SET THIS IN VERCEL PRODUCTION to  https://getlifafa.co.in  — the bare domain,
# no trailing slash, NOT www. www.getlifafa.co.in redirects to it, so a link
# built on www costs every guest an extra hop and splits the canonical URL in
# two. Preview may be left empty: a preview then uses its own branch address.
#
# Optional everywhere. Unset, the origin falls back in this order: the
# deployment's own Vercel address, then https://getlifafa.co.in (the fallback
# is written once, in lib/siteUrl.ts). So a build that forgets it still hands
# guests working links rather than links to localhost.
#
# LOCALLY, set it to  http://localhost:3000  in .env.local if you want invite
# links and check-in QR codes that open against the dev server. Without it they
# are built on the live domain, which is right for sharing and wrong for
# testing the check-in flow end to end.
#
# Inlined into the browser bundle at build time, so a change needs a redeploy.
NEXT_PUBLIC_SITE_URL=

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon / public
# Safe to expose: it is bound by Row Level Security, which is why every policy
# in supabase/migrations/0001_initial.sql matters.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role
# BYPASSES Row Level Security. Server only, never prefixed NEXT_PUBLIC_, and
# never imported into a client component — see lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# ── Razorpay ──────────────────────────────────────────────────────────────
# Test mode until the live keys replace these. The dashboard shows a TEST MODE
# banner whenever the key id below starts with rzp_test, so a test payment can
# never be mistaken for a real one — see lib/razorpay/keys.ts.

# Dashboard -> Account & Settings -> API Keys.
# The same value as NEXT_PUBLIC_RAZORPAY_KEY_ID below. Both exist because only
# NEXT_PUBLIC_ names reach the browser, and the server should not read a
# browser variable to authenticate itself.
RAZORPAY_KEY_ID=

# The other half of that pair. SIGNS API CALLS AGAINST THE ACCOUNT: anyone
# holding it can create orders, issue refunds and read every payment ever taken.
# Server only, never prefixed NEXT_PUBLIC_ — see lib/razorpay/client.ts.
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks, set when the webhook is created.
# NOT the key secret; a separate value Razorpay signs each delivery with.
#
# This is the whole trust boundary for payment: /api/razorpay/webhook is a
# public URL, and this secret is the only thing separating a real payment from
# anyone who found it. Unset, the route refuses every delivery — it fails
# closed rather than open, so a missing value is a payment that does not
# complete and not an invitation anyone can publish for free.
RAZORPAY_WEBHOOK_SECRET=

# The publishable key id, and the one Razorpay value meant to be public: it
# names the account to the checkout and authorises nothing on its own. Same
# value as RAZORPAY_KEY_ID above.
# Inlined into the browser bundle at build time, so a change needs a redeploy.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── The owner's admin dashboard at /admin ─────────────────────────────────
# Nothing to do with Supabase Auth. There is no admin row and no admin table:
# these three variables ARE the account. Change one and redeploy, and the old
# credential no longer exists.

# The username typed into /admin/login. Anything you like; it is not an email
# and it is never shown to a host or a guest.
ADMIN_USERNAME=

# A bcrypt hash of the admin password. NEVER the password itself.
# Generate one with:  npm run hash-admin-password
# Quote the value if your shell or editor treats $ specially.
ADMIN_PASSWORD_HASH=

# The key the admin session cookie is signed with. At least 32 characters of
# randomness — a guessable value here is a forgeable session, and this is the
# only thing standing behind the login page. Rotating it signs everyone out.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ── Sarvam AI, for the Translate button in the editor ─────────────────────
# Dashboard -> API Keys at dashboard.sarvam.ai. Server only, never prefixed
# NEXT_PUBLIC_: it spends credits, and only app/api/translate/route.ts reads it.
# Unset, the Translate button says translation is not set up and the editor
# carries on working; hosts can still type the other language themselves.
SARVAM_API_KEY=

# ── Alerts to the owner, by email ─────────────────────────────────────────
# Sent through Resend's HTTP API (lib/email/alerts.ts) when the payment webhook
# takes a payment and will not publish the invitation: the amount captured is
# not the amount ordered, or the order was priced for a cheaper template. The
# same event is listed in /admin under Payments to review whether or not the
# email goes; unset, the alert is written to the server log instead.

# resend.com -> API Keys. Server only, never prefixed NEXT_PUBLIC_.
RESEND_API_KEY=

# Where the alert is sent: the owner's own address.
PAYMENT_ALERT_EMAIL=

# Who it is from, as  Lifafa alerts <alerts@getlifafa.co.in>  on a domain
# verified with Resend. Optional: unset, Resend's test sender is used, which
# only delivers to the address the Resend account was opened with.
ALERT_EMAIL_FROM=

# ── Meta Pixel, for measuring ads ─────────────────────────────────────────
# Events Manager -> Data sources -> the pixel -> its ID (digits only).
# Optional: a Vercel production build is given Lifafa's own id by
# next.config.ts when this is empty. Set it to override that, or locally to
# test the pixel. Empty off production, the pixel is not loaded at all and
# every tracking call does nothing, so local and preview builds send Meta
# nothing. It runs on the landing page, /create, /login, /dashboard and the
# policy pages, and never on a guest's invitation, a sample, check-in or
# /admin: see lib/metaPixel.ts. Inlined at build time, so a change needs a
# redeploy.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional. Business Manager -> Brand safety -> Domains -> Meta-tag
# verification: the `content` value alone. Set, every page carries
# <meta name="facebook-domain-verification" content="...">.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
