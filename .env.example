# Copy to .env.local and fill in from the Supabase dashboard.
# .env.local is gitignored; this file is the committed template and must stay empty.

# The origin invite links are built on, for example https://example.com.
# Optional. Leave it empty to use the deployment's own address: on Vercel, the
# production domain or the preview's branch address; locally, whatever address
# the page was opened on. Set it for Production only, once the real domain is
# live. Inlined at build time, so a change needs a redeploy.
NEXT_PUBLIC_SITE_URL=

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon / public
# Safe to expose: it is bound by Row Level Security, which is why every policy
# in supabase/migrations/0001_initial.sql matters.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role
# BYPASSES Row Level Security. Server only, never prefixed NEXT_PUBLIC_, and
# never imported into a client component — see lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=
